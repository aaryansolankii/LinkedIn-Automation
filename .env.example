# Copy to ~/.linkedin-mcp/.env (values set in your MCP client's "env" take precedence).

# LinkedIn developer app, needed to log in: https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Optional
# LINKEDIN_REDIRECT_URI=http://localhost:8000/callback
# POSTING_TIME=10:00
# LINKEDIN_API_VERSION=202610

# Post as a company page instead of yourself (needs the app's "Community Management API" product)
# LINKEDIN_AUTHOR_URN=urn:li:organization:123456
# LINKEDIN_SCOPES=openid profile w_member_social w_organization_social r_organization_social
